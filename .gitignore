# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# android/build.gradle.kts relocates Gradle's output dir to android/build/,
# which the root-anchored /build/ rule above does not cover.
/android/build/

# Catch build output at any depth, and Gradle's caches.
build/
.gradle/

# Android signing material - never commit these
*.jks
*.keystore
key.properties
android/key.properties

# Apple signing material
*.p12
*.cer
*.mobileprovision

# Backend service config. The app is offline-only; if any of these reappear
# they carry project ids and API keys that should not be published.
google-services.json
GoogleService-Info.plist
lib/firebase_options.dart
firebase.json
.firebaserc

# Environment and secrets
.env
.env.*
*.pem
secrets.properties

# Local agent and editor configuration: contains machine-specific absolute
# paths, so it leaks the developer's username when committed.
.claude/

# Ignore vscode AI rules. Written with forward slashes, since git ignore
# patterns do not accept backslashes as separators.
.github/instructions/codacy.instructions.md

# Local scratch assets that are not shipped with the app
lib/assets/blob/

